{
  "name": "@byteschneiderei/n8n-nodes-getmyinvoices",
  "version": "0.2.3",
  "description": "n8n node for GetMyInvoices API",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "ByteSchneiderei GmbH",
    "email": "office@byteschneiderei.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSchneiderei/n8n-nodes-getmyinvoices.git"
  },
  "bugs": {
    "url": "https://github.com/ByteSchneiderei/n8n-nodes-getmyinvoices/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "test:api": "npx ts-node test/api_integration_test.ts",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GetMyInvoicesApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GetMyInvoices/GetMyInvoices.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/jest": "^30.0.0",
    "auto-changelog": "^2.5.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
